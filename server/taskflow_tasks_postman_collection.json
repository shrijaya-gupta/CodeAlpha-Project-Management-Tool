  "item": [
    {
      "name": "Create Task in Project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Implement User Authentication UI\",\n  \"description\": \"Design and implement login/signup forms with validation feedback\",\n  \"priority\": \"high\",\n  \"status\": \"todo\",\n  \"dueDate\": \"2026-12-15T18:00:00.000Z\",\n  \"assignees\": [\"{{member_user_id}}\"]\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/projects/{{project_id}}/tasks",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "projects", "{{project_id}}", "tasks"]
        }
      }
    },
    {
      "name": "List Project Tasks (Filters, Search & Pagination)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/projects/{{project_id}}/tasks?status=todo&priority=high&search=Auth&page=1&limit=10&sortBy=dueDate&order=asc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "projects", "{{project_id}}", "tasks"],
          "query": [
            { "key": "status", "value": "todo" },
            { "key": "priority", "value": "high" },
            { "key": "search", "value": "Auth" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "sortBy", "value": "dueDate" },
            { "key": "order", "value": "asc" }
          ]
        }
      }
    },
